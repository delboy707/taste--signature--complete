// PROPOSAL ONLY - NOT DEPLOYED, NOT USED BY ANY CODE IN THIS REPO.
//
// This is the hardening that used to be baked directly into the repo's
// checked-in firestore.rules, undeployed, silently drifted from what's
// actually live (see MIGRATION_RUNBOOK.md). Pulled out here so
// firestore.rules can be an honest, verbatim copy of what is deployed
// (firestore.rules itself) with nothing extra mixed in.
//
// Three changes relative to live, each independent and separately
// reviewable - none of them are needed by, or applied as part of, the
// incremental-save migration:
//
//   1. companies/{companyId} update: restricts company-settings updates
//      to the company's ownerId, not any company member.
//   2. experiences/{experienceId} create: validates productInfo.name
//      shape/length.
//   3. experiences/{experienceId} update: requires
//      request.resource.data.updatedBy == request.auth.uid. NOTE: if
//      this is ever adopted, confirm every write path sets updatedBy
//      first (this migration's saveExperiences() already does, as a
//      descriptive field, but nothing currently depends on the rule
//      enforcing it).
//
// Deploy only as its own deliberate change, with its own review - not
// bundled into an unrelated migration.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user belongs to company
    function belongsToCompany(companyId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }

    // User profiles - users can only access their own profile
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Company data - only users belonging to the company can access
    match /companies/{companyId} {
      // Allow read if user belongs to this company
      allow read: if belongsToCompany(companyId);

      // (1) Allow ONLY the company owner to update company settings
      allow update: if belongsToCompany(companyId)
                    && resource.data.ownerId == request.auth.uid;

      // Allow create only during signup (user creates their own company)
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;

      // Company experiences - shared by all users in the company
      match /experiences/{experienceId} {
        allow read: if belongsToCompany(companyId);
        // (2) Validate productInfo shape/length on create
        allow create: if belongsToCompany(companyId)
                      && request.resource.data.companyId == companyId
                      && request.resource.data.addedBy == request.auth.uid
                      && request.resource.data.productInfo is map
                      && (!("name" in request.resource.data.productInfo) ||
                          (request.resource.data.productInfo.name is string
                           && request.resource.data.productInfo.name.size() > 0
                           && request.resource.data.productInfo.name.size() <= 500));
        // (3) Require updatedBy on update
        allow update: if belongsToCompany(companyId)
                      && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if belongsToCompany(companyId);
      }

      // Company products master data
      match /products/{productId} {
        allow read: if belongsToCompany(companyId);
        allow write: if belongsToCompany(companyId);
      }

      // Company consumer panel data
      match /consumerPanels/{panelId} {
        allow read: if belongsToCompany(companyId);
        allow write: if belongsToCompany(companyId);
      }

      // Company team members (for future multi-user support)
      match /team/{memberId} {
        allow read: if belongsToCompany(companyId);
        allow write: if belongsToCompany(companyId);
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
